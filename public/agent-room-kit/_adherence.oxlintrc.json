{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/**",
              "components/core/**",
              "components/desk/**",
              "ui_kits/trading_room/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentNodeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|key|ref|className|style|children)$/]",
        "message": "<AgentNodeRow> doesn't accept that prop. Declared props: label, value, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|kind|variant|uppercase|dot|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, kind, variant, uppercase, dot, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|outline|dot)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'outline' | 'dot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|fullWidth|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, fullWidth, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutSegment'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|color|label|key|ref|className|style|children)$/]",
        "message": "<DonutSegment> doesn't accept that prop. Declared props: value, color, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdeaCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|rationale|tagKind|tagLabel|payoff|estCost|confidence|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IdeaCard> doesn't accept that prop. Declared props: title, rationale, tagKind, tagLabel, payoff, estCost, confidence, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IdeaCard'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:high|medium|low)$/]",
        "message": "<IdeaCard> confidence must be one of 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|value|onChange|placeholder|icon|suffix|rows|accent|disabled|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: as, value, onChange, placeholder, icon, suffix, rows, accent, disabled, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LearningTip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|children|linkLabel|onLink|tone|style|key|ref|className|style|children)$/]",
        "message": "<LearningTip> doesn't accept that prop. Declared props: label, icon, children, linkLabel, onLink, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LearningTip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|amber|green)$/]",
        "message": "<LearningTip> tone must be one of 'blue' | 'amber' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LineChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|theoretical|width|height|tone|xLabels|yTicks|area|padding|style|key|ref|className|style|children)$/]",
        "message": "<LineChart> doesn't accept that prop. Declared props: data, theoretical, width, height, tone, xLabels, yTicks, area, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|change|changeTone|desc|emphasize|style|key|ref|className|style|children)$/]",
        "message": "<MetricRow> doesn't accept that prop. Declared props: label, value, unit, change, changeTone, desc, emphasize, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrderBookLevel'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|size|key|ref|className|style|children)$/]",
        "message": "<OrderBookLevel> doesn't accept that prop. Declared props: price, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|titleColor|right|live|liveLabel|inset|pad|children|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, titleColor, right, live, liveLabel, inset, pad, children, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='PayoffPoint'] > JSXAttribute > JSXIdentifier[name!=/^(?:x|y|key|ref|className|style|children)$/]",
        "message": "<PayoffPoint> doesn't accept that prop. Declared props: x, y."
      },
      {
        "selector": "JSXOpeningElement[name.name='RfqHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|rfqId|savedAt|right|copyIcon|style|key|ref|className|style|children)$/]",
        "message": "<RfqHeader> doesn't accept that prop. Declared props: title, subtitle, rfqId, savedAt, right, copyIcon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedToggle> doesn't accept that prop. Declared props: options, value, onChange, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedToggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SegmentedToggle> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|width|height|tone|strokeWidth|fill|style|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, width, height, tone, strokeWidth, fill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|deltaTone|sub|valueColor|accent|chart|size|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: label, value, unit, delta, deltaTone, sub, valueColor, accent, chart, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<StatCard> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|tone|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|green)$/]",
        "message": "<Switch> tone must be one of 'red' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickerItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:sym|value|delta|dir|key|ref|className|style|children)$/]",
        "message": "<TickerItem> doesn't accept that prop. Declared props: sym, value, delta, dir."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickerItem'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<TickerItem> dir must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VolHeatmap'] > JSXAttribute > JSXIdentifier[name!=/^(?:matrix|rowLabels|colLabels|min|max|cell|gap|style|key|ref|className|style|children)$/]",
        "message": "<VolHeatmap> doesn't accept that prop. Declared props: matrix, rowLabels, colLabels, min, max, cell, gap, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
