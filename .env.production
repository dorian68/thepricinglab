# Production build config (committed on purpose — contains NO secrets, only the
# public base URL of the deployed calculation backend on the VPS).
# Vite bakes this into the build for `vite build` / the Lovable production deploy.
# Local dev keeps using 127.0.0.1:8000 via the code fallback (no .env needed).
VITE_TPL_RAG_API_URL="https://tpl-api.optiquant-ia.com"
